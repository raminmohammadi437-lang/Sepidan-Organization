{
  "name": "sepidan-organization-website",
  "version": "1.0.0",
  "private": true,
  "description": "Sepidan Organization public website and role-based staff portal prototype",
  "scripts": {
    "dev": "concurrently \"npm:css:watch\" \"vite --host 127.0.0.1\"",
    "css:watch": "tailwindcss -i ./src/input.css -o ./styles.css --watch",
    "css:build": "tailwindcss -i ./src/input.css -o ./styles.css --minify",
    "build": "npm run css:build && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tailwindcss": "3.4.17",
    "vite": "^7.0.0"
  }
}
